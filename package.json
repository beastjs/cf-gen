{
  "name": "@beastjs/cf-gen",
  "version": "0.1.3",
  "description": "CLI for generating Cloudflare Wrangler configuration",
  "type": "module",
  "bin": {
    "cf-gen": "./bin/cf-gen"
  },
  "files": [
    "bin",
    "cf/wrangler-codegen.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "cf:codegen": "bun ./cf/wrangler-codegen.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "wrangler": "^4.156.0",
    "typescript": "^7.0.0"
  }
}
